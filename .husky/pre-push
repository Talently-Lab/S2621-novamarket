run_gates=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$local_sha" ]; then
    continue
  fi
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$(git merge-base "$1/develop" "$local_sha" 2>/dev/null || true)"
    if [ -z "$base" ]; then
      run_gates=1
      break
    fi
    from="$base"
  else
    from="$remote_sha"
  fi

  if ! git diff --quiet "$from" "$local_sha" -- frontend/; then
    run_gates=1
    break
  fi
done

if [ "$run_gates" = "1" ]; then
  npm run format:check && npm run lint && npm run build
fi
